# ============================================================================
# SPACE X MATH – CẤU HÌNH HỆ THỐNG (BACKEND ENVIRONMENT VARIABLES)
# Lưu ý bảo mật: File này chỉ đọc ở Backend, tuyệt đối không lộ ra Frontend.
# ============================================================================

PORT=3000
JWT_SECRET=spacex_math_super_secret_jwt_key_2026_production_grade
JWT_EXPIRES_IN_HOURS=168

# ----------------------------------------------------------------------------
# CẤU HÌNH GOOGLE GEMINI AI ENGINE (CHUYÊN TRÁCH ĐỌC VÀ CHUYỂN ĐỔI PDF)
# ----------------------------------------------------------------------------
# Nhập Google Gemini API Key chính thức từ Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=

# Tên model Gemini chính thức cấu hình tập trung tại một nơi duy nhất:
# - Mặc định đề xuất model chính thức ổn định nhất cho PDF Multimodal: gemini-2.5-pro (hoặc gemini-2.5-flash)
# - Nếu tài khoản Google AI đã được cấp quyền Gemini 4 Preview/Argon, đặt: gemini-4-argon
# - Hoặc Gemini 3.1 Pro: gemini-3.1-pro-preview
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_Requested_Target=gemini-4-argon

# Cấu hình Retry, Timeout, Rate Limit và Ngưỡng dung lượng PDF lớn
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_MS=1500
GEMINI_RATE_LIMIT_PER_MINUTE=10
GEMINI_RATE_LIMIT_PER_DAY=200
GEMINI_INLINE_PDF_MAX_BYTES=15728640
GEMINI_MIN_CONFIDENCE_THRESHOLD=0.85

# ----------------------------------------------------------------------------
# CẤU HÌNH LƯU TRỮ FILE (STORAGE & DATABASE)
# ----------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_PATH=./storage
DATABASE_PATH=./data/spacexmath.db
# Nếu sử dụng PostgreSQL độc lập khi deploy:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/spacexmath
# Nếu sử dụng MinIO / S3:
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_BUCKET=spacex-math-pdfs

